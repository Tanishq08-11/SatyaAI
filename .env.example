# SATYA AI Configuration
# Environment Variables Example

# Application settings
APP_NAME=SATYA AI
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000
API_V1_STR=/api

# Database settings (SQLite for Phase 1)
DATABASE_URL=sqlite:///./satya.db

# Logging
LOG_LEVEL=INFO

# Security / CORS (Comma-separated list or JSON array)
CORS_ORIGINS=["*"]

# LLM Provider (Optional - 'openai', 'gemini', 'anthropic', 'generic', or 'none')
LLM_PROVIDER=none
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# Retrieval Providers Configuration
# Supported SEARCH_PROVIDER options:
#   - 'duckduckgo': Free live organic web search (no API key required)
#   - 'tavily': High-accuracy factual search API (requires TAVILY_API_KEY or SEARCH_API_KEY)
#   - 'serper': Google Search API via Serper.dev (requires SERPER_API_KEY or SEARCH_API_KEY)
#   - 'brave': Brave Web Search API (requires SEARCH_API_KEY)
#   - 'mock': Deterministic mock provider for local unit testing
#   - 'none': Disables web retrieval
SEARCH_PROVIDER=duckduckgo

# General search key or provider-specific keys
SEARCH_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=

# Optional: Google Fact Check Tools API Key
GOOGLE_FACT_CHECK_API_KEY=

# Retrieval timeout in seconds
RETRIEVAL_TIMEOUT_SECONDS=8.0

# WhatsApp Cloud API Settings (Meta Developer Dashboard)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=satya_verify_token_replace_with_your_secret
META_APP_SECRET=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v21.0

